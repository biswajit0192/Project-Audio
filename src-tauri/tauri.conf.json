{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HertzSonic",
  "version": "0.1.0",
  "identifier": "com.hertzsonic.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HertzSonic",
        "width": 1000,
        "height": 700,
        "resizable": true,
        "transparent": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "native/bass.dll": "bass.dll",
      "native/bassflac.dll": "bassflac.dll"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine"
      }
    }
  }
}